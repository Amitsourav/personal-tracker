# Supabase → Project Settings → API
# Set these before deploying anywhere: src/lib/supabase/env.ts falls back to the
# author's project when they are missing, so a fresh clone would otherwise talk
# to the wrong database.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
